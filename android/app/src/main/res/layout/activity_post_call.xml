<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvPostCallTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/call_ended"
        android:textColor="@color/senior_text_secondary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPostCallPeerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Rahul"
        android:textColor="@color/senior_text_primary"
        android:textSize="44sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCallBack"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_btn_answer"
        android:text="@string/btn_call_back"
        android:textSize="32sp" />

    <Button
        android:id="@+id/btnPostCallOk"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_btn_neutral"
        android:text="@string/btn_ok"
        android:textSize="28sp" />

</LinearLayout>
