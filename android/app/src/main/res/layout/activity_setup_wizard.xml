<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SeniorCall Setup"
            android:textColor="@color/senior_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select phone role:"
            android:textColor="@color/senior_text_secondary"
            android:textSize="18sp" />

        <!-- Role Selection -->
        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/rbRoleSenior"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:checked="true"
                android:text="👵 Elder Phone (Lives on Home Wi-Fi)"
                android:textSize="19sp" />

            <RadioButton
                android:id="@+id/rbRoleFamily"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📱 Family Phone (Uses 4G/5G Cellular Data)"
                android:textSize="19sp" />
        </RadioGroup>

        <!-- Permissions Section -->
        <Button
            android:id="@+id/btnGrantPermissions"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_neutral"
            android:text="Grant Camera &amp; Mic Permissions"
            android:textSize="18sp" />

        <!-- ELDER MODE SECTION -->
        <LinearLayout
            android:id="@+id/layoutSeniorSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSeniorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:padding="12dp"
                android:text="🟢 Ready to Pair (Worldwide 4G/5G &amp; Wi-Fi)"
                android:textColor="#16A34A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Elder's Pairing QR Code:"
                android:textColor="@color/senior_text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgSeniorQr"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="10dp"
                android:contentDescription="Pairing QR Code" />

            <TextView
                android:id="@+id/tvSeniorPairCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SC-000000"
                android:textColor="@color/color_blue_video"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Point the Family phone camera at this QR code to pair instantly."
                android:textColor="@color/senior_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- FAMILY MODE SECTION -->
        <LinearLayout
            android:id="@+id/layoutFamilySetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pair with Elder's Phone:"
                android:textColor="@color/senior_text_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFamilyScanQr"
                style="@style/SeniorButton"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_video"
                android:text="📷 SCAN ELDER'S QR CODE"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvFamilyPairStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FEF3C7"
                android:padding="14dp"
                android:text="⚠️ Not Paired: Tap button above to scan Elder's QR code"
                android:textColor="#D97706"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFinishSetup"
            style="@style/SeniorButton"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_answer"
            android:text="Complete Setup"
            android:textSize="24sp" />

    </LinearLayout>
</ScrollView>
