<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/senior_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SeniorCall Family"
        android:textColor="@color/senior_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFamilyElderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FEF3C7"
        android:padding="14dp"
        android:text="Elder Status: Disconnected / Checking..."
        android:textColor="#D97706"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPairedInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/senior_text_secondary"
        android:textSize="14sp"
        android:text="Paired to: Elder Phone" />

    <Button
        android:id="@+id/btnFamilyCallVideo"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_video"
        android:text="Video Call Elder"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnFamilyCallVoice"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_voice"
        android:text="Voice Call Elder"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnFamilyRequestScreen"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_share"
        android:text="Request Elder's Screen"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnRepair"
        style="@style/SeniorButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_btn_neutral"
        android:text="⚙️ Re-pair or Change Settings"
        android:textColor="@color/senior_text_primary"
        android:textSize="16sp" />

</LinearLayout>
